# The lab images, one list, each pinned by tag and digest. .github/ci/labs.sh,
# bench/compose.yaml and the bench's lab table name these same images, and
# TestLabImagesPinnedFromOneList fails when one differs, so a row of the
# README's table can be reproduced on the build it was measured on. The
# truth files in bench/truth are per build: juice-shop-v20.3.0-*.
# Plain KEY=VALUE lines: a shell can source it and docker compose can read it.
# To move a pin: pull the new tag, run the bench's apps and claims against
# it, and change the tag, the digest and the truth files together.
AZQ_JUICE_IMAGE=bkimminich/juice-shop:v20.3.0@sha256:cea5a4af4aacee498c491491af0408934ec81d004035c0a02ef3e54395e3bf27
AZQ_VAMPI_IMAGE=erev0s/vampi:latest@sha256:0a5a224b6e14ae7da6a6ea265178ff71286ff903aec74adee98f660bb0e4ca12
AZQ_DVGA_IMAGE=dolevf/dvga:latest@sha256:040aa33c199d99f3380c9ff9a1ee5d725e9abca7b189c63a35a2a73bda79c957
AZQ_DVNA_IMAGE=appsecco/dvna:sqlite@sha256:2657051b73ac8f879d3a3b419b4618d98e4596a0fe27f8e91582c403541ef1b0
AZQ_DVWA_IMAGE=vulnerables/web-dvwa:latest@sha256:dae203fe11646a86937bf04db0079adef295f426da68a92b40e3b181f337daa7
